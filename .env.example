# Copy values into /etc/runner-controller/pve.env; never commit real credentials.
PVE_HOST=https://pve-lab:8006
PVE_NODE=pve-lab
PVE_TOKEN_ID=runnerctl@pve!runner-controller
PVE_TOKEN_SECRET=replace-me
RUNNER_DATABASE=/var/lib/runner-controller/runners.sqlite3
RUNNER_BIND_PORT=8080
RUNNER_TTL_DEFAULT=21600
